# Datasets & run outputs (root folders only — keep src/attire_compliance/data/ tracked!)
/data/
/outputs/

# Trained weights: ignore caches/intermediate checkpoints, keep ONLY v1 runtime weights
*.pt
*.pth
*.onnx
*.engine
/models/*
!/models/pretrained/
/models/pretrained/*
!/models/pretrained/yolo12n.pt
!/models/detector/
/models/detector/*
!/models/detector/yolo12n_attire_v1.pt
!/models/classifier/
/models/classifier/*
